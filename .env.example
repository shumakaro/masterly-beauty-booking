# Local development only. These are configuration values, not secrets.
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:5173"]
APP_NAME=MASTERLY API

# PostgreSQL: set privately. Migrations use the DIRECT (non-pooler) URL.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/masterly
# DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@HOST:5432/masterly
# TEST_DATABASE_URL must use a disposable database ending in _test. Tests truncate it.
# DEMO_DATABASE_URL is only for an isolated database ending in _demo or _test.
# For demo content after migrations: python -m app.db.showcase

# Auth: generate a private key; never commit the generated value.
# JWT_SECRET=<at least 32 random bytes, generated privately>
JWT_SECRET=
# COOKIE_SECURE=false is for localhost development ONLY. Production defaults to true.
COOKIE_SECURE=false
AUTH_RATE_LIMIT=20

# Docker Compose only: fill privately with two different random passwords.
# The container configuration refuses missing or empty passwords.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# Docker HTTP origin: replace CORS_ORIGINS with ["http://127.0.0.1:8080"].
# Keep COOKIE_SECURE=false only for this local HTTP setup.
